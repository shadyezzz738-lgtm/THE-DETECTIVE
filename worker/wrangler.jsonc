{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-detective-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "ALLOWED_ORIGIN": "*"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "947102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
